# Hermes environment template. Copy to .env (gitignored) and fill in.
# Full hosting guide: docs/HOSTING.md

# --- Mode -------------------------------------------------------------------
# local       = demo sign-in (synthetic principals) is ENABLED. Fine for a demo behind edge auth.
# production  = demo sign-in is DISABLED (POST /api/auth/token -> 403) and HSTS is sent.
#               Production also needs a real identity provider: see docs/HOSTING.md.
HERMES_ENV=local

# --- Storage ----------------------------------------------------------------
HERMES_DB_PATH=data/hermes.db

# --- Authentication -----------------------------------------------------------
# development = the demo registry below is used (demo-manager/demo-employee/demo-admin).
# production  = REAL OIDC auth only. The demo registry is hard-disabled regardless of
#               HERMES_ENV, and OIDC_ISSUER/OIDC_AUDIENCE/OIDC_CLIENT_ID below become
#               required - the app refuses to START (not just to serve) without them.
AUTH_MODE=development

# Required only when AUTH_MODE=production. Point OIDC_ISSUER at your IdP (e.g. Entra ID:
# https://login.microsoftonline.com/<tenant-id>/v2.0). Signature is verified against the
# IdP's own published keys via standard OIDC discovery - never a shared secret.
# OIDC_ISSUER=
# OIDC_AUDIENCE=
# OIDC_CLIENT_ID=
# Token claim holding role names; must emit values from {employee, manager, admin} -
# anything else is dropped, never granted. Entra ID: configure as App Roles.
# OIDC_ROLE_CLAIM=roles
# A sign-in's OIDC `sub` must still be linked to a coded identity via the existing
# POST /api/org/bind-principal admin action before /api/me or any employee-scoped
# route works for that person - same mechanism as development mode.

# --- Secrets ----------------------------------------------------------------
# REQUIRED (the app refuses to start without them). Strong, unique, >=16 chars, never a
# published fixture value. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
IDENTITY_MAP_SECRET=
HERMES_JWT_SECRET=

# --- Browser access ---------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser. Leave empty when the UI is
# served by this same app (the default and recommended setup). "*" is ignored on purpose.
# HERMES_CORS_ORIGINS=https://hermes.example.com

# --- Do NOT set HERMES_API_KEY for the bundled UI ---------------------------
# When set, every API call must carry an X-API-Key header, which the web UI does not send,
# so the whole UI would get 401. Protect the site at the edge (SSO proxy / VPN) instead.
# HERMES_API_KEY=

# --- Scoring (optional; defaults are the validated values) ------------------
# Changing any of these changes the scoring_config_version stamped on every result.
# HERMES_W_DEMO=0.55
# HERMES_W_CERT=0.30
# HERMES_W_DECL=0.15
# HERMES_HALF_LIFE_FAST=90
# HERMES_HALF_LIFE_MEDIUM=365
# HERMES_HALF_LIFE_SLOW=1095
# HERMES_MAX_SHORTLIST=10
# HERMES_MIN_COVERAGE=0.6
# NOTE: HERMES_HALF_LIFE was removed. Setting it makes the app refuse to start.

# --- LLM assist (optional) ---------------------------------------------------
# POST /api/requests/parse (natural-language work-request parsing) only. Leave both
# unset and the endpoint answers {"available": false, ...} - every other route,
# including ranking/decisions/audit, works identically either way (Phase 16).
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct

# --- Container only ---------------------------------------------------------
# Seed the synthetic demo database on first start of an empty volume.
# HERMES_DEMO_SEED=1

# --- Synthetic-data test mode (never with real data) ------------------------
# Uses published fixture secrets. Local development and automated tests only.
# HERMES_TEST_MODE=1

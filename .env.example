# Hermes environment template. Copy to .env (gitignored) and fill in.
# Full hosting guide: docs/HOSTING.md

# --- Mode -------------------------------------------------------------------
# local       = demo sign-in (synthetic principals) is ENABLED. Fine for a demo behind edge auth.
# production  = demo sign-in is DISABLED (POST /api/auth/token -> 403) and HSTS is sent.
#               Production also needs a real identity provider: see docs/HOSTING.md.
HERMES_ENV=local

# --- Storage ----------------------------------------------------------------
HERMES_DB_PATH=data/hermes.db

# --- Secrets ----------------------------------------------------------------
# REQUIRED (the app refuses to start without them). Strong, unique, >=16 chars, never a
# published fixture value. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
IDENTITY_MAP_SECRET=
HERMES_JWT_SECRET=

# --- Browser access ---------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser. Leave empty when the UI is
# served by this same app (the default and recommended setup). "*" is ignored on purpose.
# HERMES_CORS_ORIGINS=https://hermes.example.com

# --- Do NOT set HERMES_API_KEY for the bundled UI ---------------------------
# When set, every API call must carry an X-API-Key header, which the web UI does not send,
# so the whole UI would get 401. Protect the site at the edge (SSO proxy / VPN) instead.
# HERMES_API_KEY=

# --- Scoring (optional; defaults are the validated values) ------------------
# Changing any of these changes the scoring_config_version stamped on every result.
# HERMES_W_DEMO=0.55
# HERMES_W_CERT=0.30
# HERMES_W_DECL=0.15
# HERMES_HALF_LIFE_FAST=90
# HERMES_HALF_LIFE_MEDIUM=365
# HERMES_HALF_LIFE_SLOW=1095
# HERMES_MAX_SHORTLIST=10
# HERMES_MIN_COVERAGE=0.6
# NOTE: HERMES_HALF_LIFE was removed. Setting it makes the app refuse to start.

# --- Container only ---------------------------------------------------------
# Seed the synthetic demo database on first start of an empty volume.
# HERMES_DEMO_SEED=1

# --- Synthetic-data test mode (never with real data) ------------------------
# Uses published fixture secrets. Local development and automated tests only.
# HERMES_TEST_MODE=1

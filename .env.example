HERMES_ENV=local
HERMES_DB_PATH=data/hermes.db
# Required outside HERMES_TEST_MODE=1 — strong unique secrets (>=16 chars); never use denylisted defaults
IDENTITY_MAP_SECRET=
HERMES_JWT_SECRET=
HERMES_API_KEY=
# Scoring version is derived from config hash (not set via env display string)
HERMES_W_DEMO=0.55
HERMES_W_CERT=0.30
HERMES_W_DECL=0.15
HERMES_HALF_LIFE=180
HERMES_MAX_SHORTLIST=10
HERMES_MIN_COVERAGE=0.6
# Test only
# HERMES_TEST_MODE=1
